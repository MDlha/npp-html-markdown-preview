#include <windows.h>
#include "Resource.h"
#pragma code_page(65001)

IDD_PREVIEW_FORMAT DIALOGEX 0, 0, 205, 64
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Formát náhľadu"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Vyberte formát pre túto kartu.", -1, 10, 10, 185, 16
 DEFPUSHBUTTON "&HTML", IDYES, 10, 35, 55, 14
 PUSHBUTTON "&Markdown", IDNO, 75, 35, 55, 14
 PUSHBUTTON "&Zrušiť", IDCANCEL, 140, 35, 55, 14
END
1 VERSIONINFO
 FILEVERSION 0,8,0,0
 PRODUCTVERSION 0,8,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "Accessible Preview for Notepad++ (development build)"
   VALUE "FileVersion", "0.8"
   VALUE "ProductName", "Accessible Preview"
   VALUE "ProductVersion", "0.8"
   VALUE "OriginalFilename", "AccessiblePreview.dll"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
